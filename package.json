{
  "name": "imessage-wrapped-app",
  "version": "0.2.0-beta.5",
  "private": true,
  "license": "MIT",
  "author": "Smit Patel",
  "repository": {
    "type": "git",
    "url": "https://github.com/smitsp11/wrapped.git"
  },
  "homepage": "https://github.com/smitsp11/wrapped#readme",
  "bugs": {
    "url": "https://github.com/smitsp11/wrapped/issues"
  },
  "keywords": [
    "imessage",
    "wrapped",
    "macos",
    "typescript",
    "sqlite"
  ],
  "type": "module",
  "description": "Your iMessage group chats, wrapped: story slides and awards, made on your Mac.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wrapped": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "demo:json": "TZ=UTC tsx src/cli.ts demo --out web/public/demo.json",
    "e2e": "playwright test",
    "app:dev": "bun src/app/main.ts",
    "app:build": "vite build web && bun build --compile src/app/main.ts --asset web/dist --outfile release/wrapped",
    "release": "sh scripts/release.sh",
    "test:bun": "tsx scripts/parityFixture.ts && npm run app:build && bun test tests-bun",
    "og": "tsx scripts/og.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
